import java.util.*;
public class Main {
    public static void main(String[] args) {
        int[]nums={1,1,2,2,3,4,4};
        int k=1;
        for(int i=1;i<nums.length;i++){
            if(nums[i]!=nums[k-1]){
               nums[k]=nums[i];
               k++;
            }
        }
        System.out.println("no. of unique elements:"+k);
        System.out.println("array:");
        for(int i=0;i<k;i++){
            System.out.println(nums[i]+" ");
        }
    
    }
} 
