import java.util.Scanner;
public class pract1 {
    public static void main(String[] args) {
         Scanner sc= new Scanner(System.in);
         int size=sc.nextInt();
         String[] arr= new String[size];
         int total_length=0;
         for(int i=0; i<arr.length;i++){
            arr[i]=sc.next();
            total_length+=arr[i].length();
         }
         System.out.println(total_length);
    }
}
