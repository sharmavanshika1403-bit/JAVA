import java.util.*;
public class Main {

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int position= sc.nextInt();
        int bitmask= 1<<position;
        if((bitmask & n)==0){
            System.out.println("bit was zero");
        }
        else{
            System.out.println("bit was 1");
        }

        
    }
}
